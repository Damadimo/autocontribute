[Unit]
Description=Create a verified complete Autocontribute state backup
Documentation=https://github.com/Damadimo/autocontribute/blob/main/docs/systemd-deployment.md
OnFailure=autocontribute-failure@%n.service
StartLimitIntervalSec=8h
StartLimitBurst=2
RequiresMountsFor=/var/lib/autocontribute/state /var/backups/autocontribute

[Service]
Type=oneshot
User=autocontribute
Group=autocontribute
WorkingDirectory=/var/lib/autocontribute
UMask=0077

Environment=HOME=/var/lib/autocontribute
Environment=TMPDIR=/var/backups/autocontribute
Environment=NO_COLOR=1
Environment=PYTHONUNBUFFERED=1

ExecStartPre=/usr/bin/test -x /opt/autocontribute/current/.venv/bin/autocontribute
ExecStartPre=/usr/bin/test -r /etc/autocontribute/autocontribute.yml
ExecStartPre=/usr/bin/test -d /var/lib/autocontribute/state
ExecStartPre=/usr/bin/test -d /var/backups/autocontribute
ExecStart=/usr/bin/flock --exclusive --timeout 21600 /var/lib/autocontribute/operation.lock /usr/local/libexec/autocontribute-backup
ExecStartPost=/usr/bin/touch /var/lib/autocontribute/health/backup-success

TimeoutStartSec=7h
TimeoutStopSec=2m
KillMode=control-group
Restart=no
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
ReadOnlyPaths=/etc/autocontribute /opt/autocontribute
ReadWritePaths=/var/backups/autocontribute /var/lib/autocontribute

StandardOutput=journal
StandardError=journal
SyslogIdentifier=autocontribute-backup
