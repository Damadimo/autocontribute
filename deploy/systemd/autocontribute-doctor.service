[Unit]
Description=Run Autocontribute deployment preflight
Documentation=https://github.com/Damadimo/autocontribute/blob/main/docs/systemd-deployment.md
Wants=network-online.target
Requires=autocontribute-rootless-docker.service
After=network-online.target autocontribute-rootless-docker.service
RequiresMountsFor=/var/lib/autocontribute/state/workspaces
RequiresMountsFor=/var/lib/autocontribute/state /var/backups/autocontribute
RequiresMountsFor=/var/lib/autocontribute/docker
OnFailure=autocontribute-failure@%n.service
OnFailure=autocontribute-alert@%n.service

[Service]
Type=oneshot
User=autocontribute
Group=autocontribute
WorkingDirectory=/var/lib/autocontribute
UMask=0077

Environment=HOME=/var/lib/autocontribute
Environment=TMPDIR=/var/lib/autocontribute/tmp
Environment=NO_COLOR=1
Environment=PYTHONUNBUFFERED=1
Environment=AUTOCONTRIBUTE_REQUIRE_SYSTEMD_ASSETS=1
Environment="AUTOCONTRIBUTE_CREDENTIAL_NAMES=OPENAI_API_KEY AUTOCONTRIBUTE_GITHUB_TOKEN"
LoadCredentialEncrypted=OPENAI_API_KEY:/etc/autocontribute/credentials/OPENAI_API_KEY.cred
LoadCredentialEncrypted=AUTOCONTRIBUTE_GITHUB_TOKEN:/etc/autocontribute/credentials/AUTOCONTRIBUTE_GITHUB_TOKEN.cred

ExecStartPre=/usr/bin/test -x /opt/autocontribute/current/.venv/bin/autocontribute
ExecStartPre=/opt/autocontribute/current/.venv/bin/autocontribute deployment verify-systemd-assets
ExecStartPre=/usr/bin/test -r /etc/autocontribute/autocontribute.yml
ExecStartPre=/usr/bin/test -d /var/lib/autocontribute/state
ExecStartPre=/usr/bin/test -d /var/lib/autocontribute/state/workspaces
ExecStartPre=/usr/bin/test -d /var/lib/autocontribute/docker
ExecStartPre=/usr/bin/test -d /var/lib/autocontribute/tmp
ExecStartPre=/usr/bin/test -d /var/backups/autocontribute
ExecStart=/usr/bin/flock --exclusive --timeout 7200 /var/lib/autocontribute/operation.lock /usr/local/libexec/autocontribute-worker doctor

TimeoutStartSec=20m
TimeoutStopSec=2m
KillMode=control-group
Restart=no

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
ReadOnlyPaths=/etc/autocontribute /opt/autocontribute /var/lib/autocontribute/docker
ReadWritePaths=/var/lib/autocontribute

StandardOutput=journal
StandardError=journal
SyslogIdentifier=autocontribute-doctor
