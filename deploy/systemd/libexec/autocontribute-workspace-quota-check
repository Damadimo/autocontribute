#!/usr/bin/bash
set -euo pipefail

umask 077

readonly workspace_root="${1:-}"
readonly maximum_bytes=21474836480
readonly maximum_inodes=524288

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

if [[
  $# -ne 1 ||
  "$workspace_root" != /* ||
  "$workspace_root" == / ||
  "$workspace_root" == *$'\n'* ||
  "$workspace_root" == */../* ||
  "$workspace_root" == */./*
]]; then
  fail 'Autocontribute workspace quota check received an invalid path or arguments'
fi
if [[ "$UID" == 0 ]]; then
  fail 'Autocontribute workspace quota check must not run as root'
fi
if [[ ! -d "$workspace_root" || -L "$workspace_root" ]]; then
  fail 'Autocontribute workspace quota mount is unavailable'
fi
canonical_workspace_root="$(realpath "$workspace_root")" || \
  fail 'Autocontribute could not canonicalize the workspace quota mount'
readonly canonical_workspace_root
if [[ "$canonical_workspace_root" != "$workspace_root" ]]; then
  fail 'Autocontribute workspace quota mount must be an exact real path'
fi

service_gid="$(id --group)" || fail 'Autocontribute could not verify the service group'
readonly service_gid
workspace_owner="$(stat --format=%u -- "$workspace_root")" || \
  fail 'Autocontribute could not inspect the workspace quota mount'
workspace_group="$(stat --format=%g -- "$workspace_root")" || \
  fail 'Autocontribute could not inspect the workspace quota mount'
workspace_mode="$(stat --format=%a -- "$workspace_root")" || \
  fail 'Autocontribute could not inspect the workspace quota mount'
readonly workspace_owner workspace_group workspace_mode
if [[
  "$workspace_owner" != "$UID" ||
  "$workspace_group" != "$service_gid" ||
  "$workspace_mode" != 700
]]; then
  fail 'Autocontribute workspace quota mount has unsafe ownership or permissions'
fi

mount_target="$(
  findmnt --noheadings --raw --target "$workspace_root" --output TARGET
)" || fail 'Autocontribute could not resolve the workspace quota mount'
filesystem_type="$(
  findmnt --noheadings --raw --target "$workspace_root" --output FSTYPE
)" || fail 'Autocontribute could not resolve the workspace quota filesystem'
filesystem_root="$(
  findmnt --noheadings --raw --target "$workspace_root" --output FSROOT
)" || fail 'Autocontribute could not resolve the workspace quota filesystem root'
mount_options="$(
  findmnt --noheadings --raw --target "$workspace_root" --output OPTIONS
)" || fail 'Autocontribute could not resolve the workspace quota mount options'
mount_device="$(
  findmnt --noheadings --raw --target "$workspace_root" --output MAJ:MIN
)" || fail 'Autocontribute could not resolve the workspace quota mount device number'
readonly mount_target filesystem_type filesystem_root mount_options mount_device

if [[ "$mount_target" != "$workspace_root" ]]; then
  fail 'Autocontribute workspaces are not an exact dedicated mount'
fi
if [[ "$filesystem_type" != ext4 ]]; then
  fail 'Autocontribute workspace quota mount must use ext4 with a fixed inode table'
fi
if [[ "$filesystem_root" != / ]]; then
  fail 'Autocontribute workspace quota mount must expose one whole filesystem'
fi
if [[ ! "$mount_device" =~ ^[0-9]+:[0-9]+$ ]]; then
  fail 'Autocontribute workspace quota mount reported an invalid device number'
fi
case ",$mount_options," in
  *,rw,*) ;;
  *) fail 'Autocontribute workspace quota mount is not writable' ;;
esac
case ",$mount_options," in
  *,nodev,*) ;;
  *) fail 'Autocontribute workspace quota mount must use nodev' ;;
esac
case ",$mount_options," in
  *,nosuid,*) ;;
  *) fail 'Autocontribute workspace quota mount must use nosuid' ;;
esac
case ",$mount_options," in
  *,bind,* | *,rbind,*)
    fail 'Autocontribute workspace quota mount cannot be a bind mount'
    ;;
esac

mount_table="$(
  findmnt --noheadings --raw --output MAJ:MIN,TARGET
)" || fail 'Autocontribute could not inspect the host mount table'
readonly mount_table
matching_mount_count=0
while read -r candidate_device candidate_target; do
  if [[ "$candidate_device" != "$mount_device" ]]; then
    continue
  fi
  matching_mount_count=$((matching_mount_count + 1))
  if [[ "$candidate_target" != "$workspace_root" ]]; then
    fail 'Autocontribute workspace quota device is mounted at another host path'
  fi
done <<< "$mount_table"
readonly matching_mount_count
unset candidate_device candidate_target
if [[ "$matching_mount_count" -lt 1 ]]; then
  fail 'Autocontribute workspace quota device is mounted at another host path'
fi

workspace_stat_device="$(stat --format=%d -- "$workspace_root")" || \
  fail 'Autocontribute could not inspect the workspace mount device'
parent_device="$(stat --format=%d -- "${workspace_root%/*}")" || \
  fail 'Autocontribute could not inspect the workspace parent device'
readonly workspace_stat_device parent_device
if [[ "$workspace_stat_device" == "$parent_device" ]]; then
  fail 'Autocontribute workspaces are not isolated on a separate filesystem'
fi

filesystem_limits="$(
  stat --file-system --format=%S:%b:%c -- "$workspace_root"
)" || fail 'Autocontribute could not inspect workspace filesystem limits'
readonly filesystem_limits
IFS=: read -r block_size total_blocks total_inodes trailing <<< "$filesystem_limits"
readonly block_size total_blocks total_inodes trailing
if [[
  ! "$block_size" =~ ^[1-9][0-9]*$ ||
  ! "$total_blocks" =~ ^[1-9][0-9]*$ ||
  ! "$total_inodes" =~ ^[1-9][0-9]*$ ||
  -n "$trailing"
]]; then
  fail 'Autocontribute workspace filesystem reported invalid limits'
fi
if (( block_size > maximum_bytes || total_blocks > maximum_bytes / block_size )); then
  fail 'Autocontribute workspace filesystem exceeds the byte ceiling'
fi
if (( total_inodes > maximum_inodes )); then
  fail 'Autocontribute workspace filesystem exceeds the inode ceiling'
fi
