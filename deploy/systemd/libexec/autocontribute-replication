#!/usr/bin/bash
set -euo pipefail

umask 077

readonly executable="${AUTOCONTRIBUTE_EXECUTABLE:-/opt/autocontribute/current/.venv/bin/autocontribute}"
readonly config="${AUTOCONTRIBUTE_CONFIG:-/etc/autocontribute/autocontribute.yml}"
readonly credential_directory="${CREDENTIALS_DIRECTORY:-}"

if [[ ! -x "$executable" || ! -r "$config" ]]; then
  printf 'Autocontribute replication prerequisites are unavailable\n' >&2
  exit 1
fi
"$executable" deployment verify-systemd-assets
if [[ -z "$credential_directory" || ! -d "$credential_directory" || \
      -L "$credential_directory" ]]; then
  printf 'Autocontribute replication credentials are not configured\n' >&2
  exit 1
fi

unset AWS_CONFIG_FILE AWS_CONTAINER_AUTHORIZATION_TOKEN \
  AWS_CONTAINER_CREDENTIALS_FULL_URI AWS_CONTAINER_CREDENTIALS_RELATIVE_URI \
  AWS_PROFILE AWS_ROLE_ARN AWS_SHARED_CREDENTIALS_FILE AWS_WEB_IDENTITY_TOKEN_FILE
export AWS_EC2_METADATA_DISABLED=true

# An empty AWS_SESSION_TOKEN credential declares a long-lived access key that
# issues no session token; the key pair itself must always be non-empty.
for credential_name in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN; do
  credential_path="$credential_directory/$credential_name"
  if [[ ! -f "$credential_path" || -L "$credential_path" ]]; then
    printf 'A required AWS replication credential is unavailable\n' >&2
    exit 1
  fi
  credential_value="$(<"$credential_path")"
  if [[ "$credential_value" == *$'\n'* ]]; then
    printf 'An AWS replication credential is multiline\n' >&2
    exit 1
  fi
  if [[ -z "$credential_value" && "$credential_name" != AWS_SESSION_TOKEN ]]; then
    printf 'A required AWS replication credential is empty\n' >&2
    exit 1
  fi
  if [[ -n "$credential_value" ]]; then
    printf -v "$credential_name" '%s' "$credential_value"
    export "${credential_name?}"
  else
    unset "${credential_name?}"
  fi
  unset credential_path credential_value
done
unset credential_name

"$executable" state replicate-next-s3 --config "$config"

# Prune only after the replication pass so a freshly proven receipt frees its
# older bundle in the same run; a gc failure pages via OnFailure without
# undoing the replication that already completed above.
exec "$executable" state gc-bundles --config "$config"
