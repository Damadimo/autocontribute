#!/usr/bin/bash
set -euo pipefail

umask 077

readonly executable="${AUTOCONTRIBUTE_EXECUTABLE:-/opt/autocontribute/current/.venv/bin/autocontribute}"
readonly config="${AUTOCONTRIBUTE_CONFIG:-/etc/autocontribute/autocontribute.yml}"
readonly credential_names="${AUTOCONTRIBUTE_CREDENTIAL_NAMES:-}"
readonly credential_directory="${CREDENTIALS_DIRECTORY:-}"
readonly operation="${1:-run}"
readonly runtime_directory="/run/autocontribute"
readonly docker_socket="$runtime_directory/docker.sock"
readonly rootful_docker_socket="/var/run/docker.sock"
readonly rootless_docker_check="/usr/local/libexec/autocontribute-rootless-docker-check"
readonly storage_capacity_check="/usr/local/libexec/autocontribute-storage-capacity-check"
readonly docker_data_check="/usr/local/libexec/autocontribute-docker-data-check"
readonly workspace_quota_check="/usr/local/libexec/autocontribute-workspace-quota-check"
readonly state_root="/var/lib/autocontribute/state"
readonly backup_root="/var/backups/autocontribute"
readonly health_directory="/var/lib/autocontribute/health"
readonly worker_attempt_marker="$health_directory/worker-attempt"
readonly docker_data_root="/var/lib/autocontribute/docker"
readonly workspace_root="/var/lib/autocontribute/state/workspaces"

case "$operation" in
  doctor | run) ;;
  *)
    printf 'Unsupported Autocontribute systemd operation\n' >&2
    exit 1
    ;;
esac

if [[ ! -x "$executable" ]]; then
  printf 'Autocontribute executable is unavailable\n' >&2
  exit 1
fi
"$executable" deployment verify-systemd-assets
if [[ ! -r "$config" ]]; then
  printf 'Autocontribute configuration is unavailable\n' >&2
  exit 1
fi
if [[ ! -x "$rootless_docker_check" ]]; then
  printf 'Autocontribute rootless Docker boundary check is unavailable\n' >&2
  exit 1
fi
if [[ ! -x "$storage_capacity_check" ]]; then
  printf 'Autocontribute storage capacity check is unavailable\n' >&2
  exit 1
fi
if [[ ! -x "$docker_data_check" ]]; then
  printf 'Autocontribute Docker data-root boundary check is unavailable\n' >&2
  exit 1
fi
if [[ ! -x "$workspace_quota_check" ]]; then
  printf 'Autocontribute workspace quota check is unavailable\n' >&2
  exit 1
fi
"$storage_capacity_check" "$state_root" "$backup_root" --state-writable
"$workspace_quota_check" --structural "$workspace_root"
export AUTOCONTRIBUTE_REQUIRED_STORAGE_ROOT="$state_root"
export AUTOCONTRIBUTE_REQUIRED_WORKSPACE_ROOT="$workspace_root"
if [[ "$operation" == run ]]; then
  if [[ ! -d "$health_directory" || -L "$health_directory" || \
        ! -w "$health_directory" ]]; then
    printf 'Autocontribute health directory is unavailable or unsafe\n' >&2
    exit 1
  fi
  replication_check=(
    state verify-latest-s3
    --config "$config"
    --if-configured
    --max-age-hours 36
  )
  if [[ -e "$worker_attempt_marker" || -L "$worker_attempt_marker" ]]; then
    if [[ ! -f "$worker_attempt_marker" || -L "$worker_attempt_marker" ]]; then
      printf 'Autocontribute worker-attempt marker is unsafe\n' >&2
      exit 1
    fi
    replication_check+=(--required-after "$worker_attempt_marker")
  fi
  "$executable" "${replication_check[@]}"
  unset replication_check

  if [[ ! "${INVOCATION_ID:-}" =~ ^[0-9A-Fa-f]{32}$ ]]; then
    printf 'Autocontribute systemd invocation identity is unavailable or invalid\n' >&2
    exit 1
  fi
  worker_attempt_temporary="$health_directory/.worker-attempt.${INVOCATION_ID}.tmp"
  cleanup_worker_attempt_temporary() {
    /usr/bin/rm -f -- "$worker_attempt_temporary"
  }
  trap cleanup_worker_attempt_temporary EXIT
  if ! (set -o noclobber; umask 077; printf '%s\n' "$INVOCATION_ID" >"$worker_attempt_temporary") \
    2>/dev/null; then
    printf 'Autocontribute worker-attempt marker could not be staged\n' >&2
    exit 1
  fi
  /usr/bin/chmod 0400 -- "$worker_attempt_temporary"
  /usr/bin/sync -f "$worker_attempt_temporary"
  /usr/bin/mv --no-target-directory -- "$worker_attempt_temporary" "$worker_attempt_marker"
  /usr/bin/sync -f "$health_directory"
  trap - EXIT
  unset worker_attempt_temporary

  # Workspace cleanup is reported hygiene, not a scheduling gate: a retained or corrupt old
  # workspace must never block the scheduled contribution run. Disk exhaustion is enforced
  # separately by the workspace quota headroom check below.
  gc_status=0
  "$executable" state gc-workspaces \
    --config "$config" \
    --older-than-days 7 \
    --limit 25 \
    --execute || gc_status=$?
  if [[ "$gc_status" -ne 0 ]]; then
    printf 'Autocontribute workspace cleanup reported a problem (exit %s); continuing\n' \
      "$gc_status" >&2
  fi
  unset gc_status
fi
"$workspace_quota_check" --headroom "$workspace_root"
export XDG_RUNTIME_DIR="$runtime_directory"
export DOCKER_HOST="unix://$docker_socket"
unset DOCKER_CONTEXT DOCKER_CERT_PATH DOCKER_TLS_VERIFY
"$rootless_docker_check" "$runtime_directory" "$docker_socket" "$rootful_docker_socket"
"$docker_data_check" --daemon "$docker_data_root"
export AUTOCONTRIBUTE_REQUIRED_DOCKER_ROOT="$docker_data_root"

if [[ -z "$credential_names" || -z "$credential_directory" ]]; then
  printf 'Autocontribute systemd credentials are not configured\n' >&2
  exit 1
fi

declare -A loaded_credentials=()
for credential_name in $credential_names; do
  if [[ ! "$credential_name" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
    printf 'An Autocontribute credential has an invalid environment name\n' >&2
    exit 1
  fi
  case "$credential_name" in
    AUTOCONTRIBUTE_ALLOW_AUTO_PUBLISH | AUTOCONTRIBUTE_REQUIRED_DOCKER_ROOT | AUTOCONTRIBUTE_REQUIRED_STORAGE_ROOT | AUTOCONTRIBUTE_REQUIRED_WORKSPACE_ROOT | AUTOCONTRIBUTE_REQUIRE_SYSTEMD_ASSETS | BASH* | CDPATH | DOCKER_* | ENV | GIT_* | HOME | IFS | LD_* | PATH | PYTHON* | SHELL | XDG_*)
      printf 'An Autocontribute credential uses a reserved environment name\n' >&2
      exit 1
      ;;
  esac
  if [[ -n "${loaded_credentials[$credential_name]:-}" ]]; then
    printf 'An Autocontribute credential name is duplicated\n' >&2
    exit 1
  fi
  loaded_credentials[$credential_name]=1

  credential_path="$credential_directory/$credential_name"
  if [[ ! -f "$credential_path" || -L "$credential_path" ]]; then
    printf 'A required Autocontribute credential is unavailable\n' >&2
    exit 1
  fi
  credential_value="$(<"$credential_path")"
  if [[ -z "$credential_value" || "$credential_value" == *$'\n'* ]]; then
    printf 'A required Autocontribute credential is empty or multiline\n' >&2
    exit 1
  fi
  printf -v "$credential_name" '%s' "$credential_value"
  export "${credential_name?}"
  unset credential_value credential_path
done

unset credential_name loaded_credentials
case "$operation" in
  doctor)
    exec "$executable" doctor --non-interactive --config "$config"
    ;;
  run)
    exec "$executable" run --scheduled --config "$config"
    ;;
esac
