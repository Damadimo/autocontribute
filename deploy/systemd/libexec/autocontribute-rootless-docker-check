#!/usr/bin/bash
set -euo pipefail

umask 077

readonly operation="${1:-}"
readonly runtime_directory="${1:-}"
readonly docker_socket="${2:-}"
readonly rootful_docker_socket="${3:-}"
readonly unit_name="autocontribute-rootless-docker.service"
readonly expected_fragment="/etc/systemd/system/autocontribute-rootless-docker.service"
readonly legacy_rootless_socket="/run/user/$UID/docker.sock"

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

if [[ "$operation" == --unit-only ]]; then
  if [[ $# -ne 1 ]]; then
    fail 'Autocontribute rootless Docker check received invalid paths'
  fi
elif [[
  $# -ne 3 || -z "$runtime_directory" ||
  "$docker_socket" != "$runtime_directory/docker.sock" ||
  -z "$rootful_docker_socket"
]]; then
  fail 'Autocontribute rootless Docker check received invalid paths'
fi
if [[ "$UID" == 0 ]]; then
  fail 'Autocontribute rootless Docker must not run as root'
fi

service_gid="$(id --group)" || fail 'Autocontribute could not verify the service group'
readonly service_gid
service_group_names="$(id --groups --name)" || fail 'Autocontribute could not verify supplementary groups'
readonly service_group_names
for service_group_name in $service_group_names; do
  if [[ "$service_group_name" == "docker" ]]; then
    fail 'Autocontribute service account must not belong to the docker group'
  fi
done
unset service_group_name

unit_property() {
  local property="$1"
  local value
  if ! value="$(
    timeout --kill-after=5s 30s \
      systemctl show "$unit_name" \
      --property="$property" --value \
      2>/dev/null
  )"; then
    fail 'Autocontribute could not inspect the rootless Docker system unit'
  fi
  if [[ ( "$property" != DropInPaths && -z "$value" ) || "$value" == *$'\n'* ]]; then
    fail 'Autocontribute rootless Docker system unit has an ambiguous property'
  fi
  printf '%s' "$value"
}

load_state="$(unit_property LoadState)"
need_daemon_reload="$(unit_property NeedDaemonReload)"
fragment_path="$(unit_property FragmentPath)"
dropin_paths="$(unit_property DropInPaths)"
readonly load_state need_daemon_reload fragment_path dropin_paths
if [[ "$load_state" != loaded ]]; then
  fail 'Autocontribute rootless Docker system unit is not loaded'
fi
if [[ "$need_daemon_reload" != no ]]; then
  fail 'Autocontribute rootless Docker system unit requires a daemon reload'
fi
if [[ "$fragment_path" != "$expected_fragment" ]]; then
  fail 'Autocontribute rootless Docker system unit has an unexpected fragment'
fi
if [[ -n "$dropin_paths" ]]; then
  fail 'Autocontribute rootless Docker system unit has an unexpected effective drop-in'
fi
if [[ ! -f "$fragment_path" || -L "$fragment_path" ]]; then
  fail 'Autocontribute rootless Docker system unit fragment is unavailable or unsafe'
fi
fragment_owner="$(stat --format=%u -- "$fragment_path")" || \
  fail 'Autocontribute could not inspect the rootless Docker system unit fragment'
fragment_group="$(stat --format=%g -- "$fragment_path")" || \
  fail 'Autocontribute could not inspect the rootless Docker system unit fragment'
fragment_mode="$(stat --format=%a -- "$fragment_path")" || \
  fail 'Autocontribute could not inspect the rootless Docker system unit fragment'
readonly fragment_owner fragment_group fragment_mode
if [[ "$fragment_owner" != 0 || "$fragment_group" != 0 || "$fragment_mode" != 644 ]]; then
  fail 'Autocontribute rootless Docker system unit fragment has unsafe ownership or permissions'
fi

if [[ "$operation" == --unit-only ]]; then
  exit 0
fi

active_state="$(unit_property ActiveState)"
sub_state="$(unit_property SubState)"
readonly active_state sub_state
if [[ "$active_state" != active || "$sub_state" != running ]]; then
  fail 'Autocontribute rootless Docker system unit is not running'
fi

if [[ ! -d "$runtime_directory" || -L "$runtime_directory" ]]; then
  fail 'Autocontribute rootless Docker runtime directory is unavailable'
fi
runtime_owner="$(stat --format=%u -- "$runtime_directory")" || \
  fail 'Autocontribute could not inspect the Docker runtime directory'
runtime_group="$(stat --format=%g -- "$runtime_directory")" || \
  fail 'Autocontribute could not inspect the Docker runtime directory'
runtime_mode="$(stat --format=%a -- "$runtime_directory")" || \
  fail 'Autocontribute could not inspect the Docker runtime directory'
readonly runtime_owner runtime_group runtime_mode
if [[ "$runtime_owner" != "$UID" || "$runtime_group" != "$service_gid" || "$runtime_mode" != 700 ]]; then
  fail 'Autocontribute rootless Docker runtime directory has unsafe ownership or permissions'
fi

if [[ ! -S "$docker_socket" || -L "$docker_socket" ]]; then
  fail 'Autocontribute rootless Docker socket is unavailable'
fi
if [[ "$legacy_rootless_socket" != "$docker_socket" ]] && \
  [[ -S "$legacy_rootless_socket" || -L "$legacy_rootless_socket" ]]; then
  fail 'Autocontribute found a legacy rootless Docker socket outside the managed runtime'
fi
docker_socket_owner="$(stat --format=%u -- "$docker_socket")" || \
  fail 'Autocontribute could not inspect the Docker socket'
docker_socket_group="$(stat --format=%g -- "$docker_socket")" || \
  fail 'Autocontribute could not inspect the Docker socket'
docker_socket_mode="$(stat --format=%a -- "$docker_socket")" || \
  fail 'Autocontribute could not inspect the Docker socket'
readonly docker_socket_owner docker_socket_group docker_socket_mode
if [[ "$docker_socket_owner" != "$UID" || "$docker_socket_group" != "$service_gid" ]]; then
  fail 'Autocontribute Docker socket is not owned by the service account'
fi
if [[ "$docker_socket_mode" != 600 && "$docker_socket_mode" != 660 ]]; then
  fail 'Autocontribute Docker socket has unsafe permissions'
fi

if [[ -S "$rootful_docker_socket" && ( -r "$rootful_docker_socket" || -w "$rootful_docker_socket" ) ]]; then
  fail 'Autocontribute service account can access the host Docker socket'
fi

export XDG_RUNTIME_DIR="$runtime_directory"
export DOCKER_HOST="unix://$docker_socket"
unset DOCKER_CONTEXT DOCKER_CERT_PATH DOCKER_TLS_VERIFY

docker_security_options=""
if ! docker_security_options="$(
  timeout --kill-after=5s 30s \
    docker --host "$DOCKER_HOST" info \
    --format '{{range .SecurityOptions}}{{println .}}{{end}}' \
    2>/dev/null
)"; then
  fail 'Autocontribute could not verify the rootless Docker daemon'
fi

rootless_option_count=0
while IFS= read -r docker_security_option; do
  if [[ "$docker_security_option" == "name=rootless" ]]; then
    rootless_option_count=$((rootless_option_count + 1))
  fi
done <<< "$docker_security_options"
unset docker_security_option docker_security_options
if [[ "$rootless_option_count" -ne 1 ]]; then
  fail 'Autocontribute Docker daemon did not report the exact rootless security option'
fi
