[Unit]
Description=Autocontribute scheduled contribution worker
Documentation=https://github.com/Damadimo/autocontribute/blob/main/docs/systemd-deployment.md
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/autocontribute/state/workspaces
OnFailure=autocontribute-failure@%n.service
StartLimitIntervalSec=8h
StartLimitBurst=2

[Service]
Type=oneshot
User=autocontribute
Group=autocontribute
WorkingDirectory=/var/lib/autocontribute
UMask=0077

Environment=HOME=/var/lib/autocontribute
Environment=TMPDIR=/var/lib/autocontribute/tmp
Environment=NO_COLOR=1
Environment=PYTHONUNBUFFERED=1
Environment="AUTOCONTRIBUTE_CREDENTIAL_NAMES=OPENAI_API_KEY AUTOCONTRIBUTE_GITHUB_TOKEN"
LoadCredentialEncrypted=OPENAI_API_KEY:/etc/autocontribute/credentials/OPENAI_API_KEY.cred
LoadCredentialEncrypted=AUTOCONTRIBUTE_GITHUB_TOKEN:/etc/autocontribute/credentials/AUTOCONTRIBUTE_GITHUB_TOKEN.cred

ExecStartPre=/usr/bin/test -x /opt/autocontribute/current/.venv/bin/autocontribute
ExecStartPre=/usr/bin/test -r /etc/autocontribute/autocontribute.yml
ExecStartPre=/usr/bin/test -d /var/lib/autocontribute/state
ExecStartPre=/usr/bin/test -d /var/lib/autocontribute/state/workspaces
ExecStartPre=/usr/bin/test -d /var/lib/autocontribute/tmp
ExecStart=/usr/bin/flock --exclusive --timeout 7200 /var/lib/autocontribute/operation.lock /usr/local/libexec/autocontribute-worker
ExecStartPost=/usr/bin/touch /var/lib/autocontribute/health/worker-success

TimeoutStartSec=7h
TimeoutStopSec=2m
KillMode=control-group
Restart=no

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
ReadOnlyPaths=/etc/autocontribute /opt/autocontribute
ReadWritePaths=/var/lib/autocontribute

StandardOutput=journal
StandardError=journal
SyslogIdentifier=autocontribute-worker
