[Unit]
Description=Record failure of Autocontribute unit %i
Documentation=https://github.com/Damadimo/autocontribute/blob/main/docs/systemd-deployment.md

[Service]
Type=oneshot
User=autocontribute
Group=autocontribute
WorkingDirectory=/var/lib/autocontribute
UMask=0077
ExecStart=/usr/local/libexec/autocontribute-record-failure %i
TimeoutStartSec=30s

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
ReadWritePaths=/var/lib/autocontribute/health

StandardOutput=journal
StandardError=journal
SyslogLevel=err
SyslogIdentifier=autocontribute-failure
