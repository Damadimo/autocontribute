[Unit]
Description=Check Autocontribute freshness and Docker storage headroom
Documentation=https://github.com/Damadimo/autocontribute/blob/main/docs/systemd-deployment.md
RequiresMountsFor=/var/lib/autocontribute/docker
OnFailure=autocontribute-failure@%n.service
RequiresMountsFor=/var/lib/autocontribute/state /var/backups/autocontribute

[Service]
Type=oneshot
User=autocontribute
Group=autocontribute
WorkingDirectory=/var/lib/autocontribute
UMask=0077
Environment=AUTOCONTRIBUTE_WORKER_MAX_AGE_SECONDS=64800
Environment=AUTOCONTRIBUTE_BACKUP_MAX_AGE_SECONDS=129600
ExecStartPre=/opt/autocontribute/current/.venv/bin/autocontribute deployment verify-systemd-assets
ExecStartPre=/opt/autocontribute/current/.venv/bin/autocontribute state verify-latest-s3 --config /etc/autocontribute/autocontribute.yml --if-configured --max-age-hours 36
ExecStartPre=/usr/local/libexec/autocontribute-docker-data-check --read-only-health /var/lib/autocontribute/docker
ExecStart=/usr/local/libexec/autocontribute-healthcheck
TimeoutStartSec=30s

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
ReadOnlyPaths=/etc/autocontribute /opt/autocontribute /var/lib/autocontribute/health /var/lib/autocontribute/state /var/lib/autocontribute/docker /var/backups/autocontribute

StandardOutput=journal
StandardError=journal
SyslogIdentifier=autocontribute-health
