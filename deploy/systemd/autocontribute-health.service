[Unit]
Description=Check Autocontribute worker and backup freshness
Documentation=https://github.com/Damadimo/autocontribute/blob/main/docs/systemd-deployment.md
OnFailure=autocontribute-failure@%n.service
RequiresMountsFor=/var/lib/autocontribute/state /var/backups/autocontribute

[Service]
Type=oneshot
User=autocontribute
Group=autocontribute
WorkingDirectory=/var/lib/autocontribute
UMask=0077
Environment=AUTOCONTRIBUTE_WORKER_MAX_AGE_SECONDS=64800
Environment=AUTOCONTRIBUTE_BACKUP_MAX_AGE_SECONDS=129600
ExecStart=/usr/local/libexec/autocontribute-healthcheck
TimeoutStartSec=30s

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
ReadOnlyPaths=/var/lib/autocontribute/health /var/lib/autocontribute/state /var/backups/autocontribute

StandardOutput=journal
StandardError=journal
SyslogIdentifier=autocontribute-health
