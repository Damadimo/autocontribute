[Unit]
Description=Supervise the Autocontribute rootless Docker daemon
Documentation=https://github.com/Damadimo/autocontribute/blob/main/docs/systemd-deployment.md
Wants=network-online.target
After=network-online.target systemd-user-sessions.service
RequiresMountsFor=/var/lib/autocontribute/docker
OnFailure=autocontribute-failure@%n.service
OnFailure=autocontribute-alert@%n.service
StartLimitIntervalSec=5m
StartLimitBurst=6

[Service]
Type=notify
NotifyAccess=all
User=autocontribute
Group=autocontribute
WorkingDirectory=/var/lib/autocontribute
UMask=0077

Environment=HOME=/var/lib/autocontribute
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin

RuntimeDirectory=autocontribute
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
ExecStartPre=/usr/bin/test -x /opt/autocontribute/current/.venv/bin/autocontribute
ExecStartPre=/opt/autocontribute/current/.venv/bin/autocontribute deployment verify-systemd-assets
ExecStartPre=/usr/local/libexec/autocontribute-rootless-docker-check --unit-only
ExecStart=/usr/local/libexec/autocontribute-rootless-docker
ExecReload=/usr/local/libexec/autocontribute-rootless-docker --reload

Restart=on-failure
RestartSec=5s
TimeoutStartSec=15m
TimeoutStopSec=3m
KillMode=control-group

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
KeyringMode=private
ReadOnlyPaths=/etc/autocontribute /opt/autocontribute /var/lib/autocontribute/docker

StandardOutput=journal
StandardError=journal
SyslogIdentifier=autocontribute-rootless-docker

[Install]
WantedBy=multi-user.target
